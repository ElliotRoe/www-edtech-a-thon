# Notion backend for the /problems board (used at build time by src/lib/notion.ts).
# Copy to `.env` and fill in. The same three vars must also be set in the deploy
# environment (Netlify/Vercel/Cloudflare dashboard) since the build fetches from Notion.

# Internal integration token (Notion → Settings → Connections → develop your own).
# The integration must be shared with BOTH databases below.
NOTION_TOKEN=

# Database ids (open the DB as a full page; the id is the 32-char hash in the URL).
NOTION_PROBLEMS_DB_ID=
NOTION_GROUPS_DB_ID=
