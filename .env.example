# Notion backend for the problem and active-project boards (used at build time by
# src/lib/notion.ts). Copy to `.env` and fill in. The same vars must also be set
# in the deploy environment (Netlify/Vercel/Cloudflare dashboard) since the build
# fetches from Notion.

# Internal integration token (Notion → Settings → Connections → develop your own).
# The integration must be shared with all databases below.
NOTION_TOKEN=

# Database ids (open the DB as a full page; the id is the 32-char hash in the URL).
NOTION_PROBLEMS_DB_ID=            # → /problem-database (grouped) + link resolution
NOTION_GROUPS_DB_ID=             # groups the problems on /problem-database
NOTION_POTENTIAL_SOLUTIONS_DB_ID= # → /project-board

# Cloudflare Web Analytics site token (Cloudflare dashboard → Analytics & Logs →
# Web Analytics → the site → Manage site → "Enable with JS snippet"; the token is
# the `token` value inside the snippet's data-cf-beacon attribute). Baked into
# every page by src/components/Layout.astro. Leave blank locally to skip the
# beacon; it must be set in the Cloudflare Pages build environment for the
# deployed site to report analytics.
CF_BEACON_TOKEN=
