---
import "../styles/global.css";

interface Props {
  title?: string | string[];
}

const { title } = Astro.props;

const navLinks = [
  { href: "/project-board", label: "Project Board" },
  { href: "/solution-gallery", label: "Solution Gallery" },
  { href: "/schedule", label: "Virtual Event" },
] as const;

// Active when the current path is (or is nested under) the link's path.
const path = Astro.url.pathname.replace(/\/$/, "");
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fffdf8" />
    <meta
      name="description"
      content="Real teachers and developers solving practical classroom problems together at EdTech-a-thon, July 20-22, 2026 in Atlanta, GA."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>
      {
        Array.isArray(title) && title.length > 0
          ? `${title.join(" – ")} – EdTech-a-thon`
          : typeof title === "string"
            ? `${title} – EdTech-a-thon`
            : "EdTech-a-thon"
      }
    </title>
  </head>
  <body class="text-slate-950">
    <main
      class="page-shell mx-auto flex w-full max-w-5xl flex-col gap-12 px-4 py-6 sm:gap-16 sm:px-8 md:gap-20 lg:px-20"
    >
      <div class="flex flex-col gap-4">
        <header
          class="flex flex-col gap-5 border-b border-slate-200 pb-6 sm:flex-row sm:items-center sm:justify-between"
        >
          <a href="/" class="flex items-center gap-3">
            <img src="/favicon.svg" alt="" class="h-12 w-12" />
            <span class="font-display text-4xl text-slate-950"
              >EdTech-a-thon</span
            >
          </a>
          <div class="flex flex-col gap-3 sm:items-end">
            <nav class="flex flex-wrap gap-2 text-sm font-semibold">
              {
                navLinks.map((link) =>
                  isActive(link.href) ? (
                    <span class="rounded-full bg-primary-400 px-3 py-1.5 text-primary-950 shadow-[0_2px_0_var(--color-primary-700)]">
                      {link.label}
                    </span>
                  ) : (
                    <a
                      href={link.href}
                      class="rounded-full border border-slate-300 px-3 py-1.5 text-slate-700 transition hover:border-primary-400 hover:bg-primary-50 hover:text-primary-900"
                    >
                      {link.label}
                    </a>
                  ),
                )
              }
            </nav>
            <p class="text-sm font-semibold text-slate-600">
              July 20 - 22, 2026 &bull; Atlanta, GA
            </p>
          </div>
        </header>

        <slot name="announcement" />
      </div>

      <slot />

      <footer class="py-8 text-center text-sm text-slate-500">
        Made with ❤️ for teachers, by a team who believes educators will <span
          class="underline">continue</span
        > to be the future of learning
        <br />
        Contact us at <a href="mailto:directors@edtechathon.com"
          >directors@edtechathon.com</a
        >
        <br />
        <a href="/code-of-conduct" class="underline">Code of Conduct</a>
      </footer>
    </main>
    <slot name="scripts" />
  </body>
</html>
