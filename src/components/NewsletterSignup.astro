---
interface Props {
  autofocus?: boolean;
  id: string;
}

const { autofocus = false, id } = Astro.props;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim();
---

<div class="flex flex-col gap-2" data-newsletter-signup>
  <form
    method="post"
    action="https://wrench-bobsled.exe.xyz/subscribe"
    class="flex flex-col gap-3"
    data-newsletter-form
  >
    <div class="flex flex-col gap-3 sm:flex-row">
      <label for={`${id}-email`} class="sr-only">Email address</label>
      <input
        id={`${id}-email`}
        type="email"
        name="email"
        autocomplete="email"
        placeholder="you@example.com"
        required
        autofocus={autofocus}
        class="min-w-0 flex-1 rounded-full border border-slate-300 bg-white px-5 py-3 text-base text-slate-950 outline-none transition placeholder:text-slate-400 focus:border-primary-500 focus:ring-2 focus:ring-primary-200"
      />
      <button
        type="submit"
        class="inline-flex items-center justify-center rounded-full bg-primary-200 px-5 py-3 text-sm font-bold text-primary-900 transition hover:bg-primary-100 disabled:cursor-wait disabled:opacity-70"
      >
        Sign Up for Our Newsletter
      </button>
    </div>
    <input
      type="text"
      name="website"
      tabindex="-1"
      autocomplete="off"
      hidden
    />
    {
      turnstileSiteKey && (
        <div
          class="cf-turnstile w-full max-w-[300px]"
          data-sitekey={turnstileSiteKey}
          data-action="newsletter_signup"
          data-appearance="interaction-only"
          data-size="flexible"
          data-theme="light"
          data-newsletter-turnstile
        />
      )
    }
  </form>
  <p
    class="min-h-5 text-sm text-slate-600"
    aria-live="polite"
    data-newsletter-status
  >
    Get updates about future events and the tools we build for educators.
  </p>
</div>
