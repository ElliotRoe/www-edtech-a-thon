---
import type { ProblemLink } from "../lib/board";

interface Props {
  problems: ProblemLink[];
  /** Text shown before the list; omit for none. */
  label?: string;
}

const { problems, label } = Astro.props;
---

{
  problems.length > 0 && (
    <div class="flex flex-wrap items-center gap-1.5">
      {label && <span class="text-xs text-slate-500">{label}</span>}
      {problems.map((problem) =>
        problem.href ? (
          <a
            href={problem.href}
            class="rounded-md bg-slate-100 px-2 py-0.5 text-xs text-slate-700 transition hover:bg-slate-200 hover:text-slate-900"
          >
            {problem.title}
          </a>
        ) : (
          <span class="rounded-md bg-slate-50 px-2 py-0.5 text-xs text-slate-500">
            {problem.title}
          </span>
        ),
      )}
    </div>
  )
}
