---
import type { BoardSolution } from "../lib/board";
import { boardCardAction, potentialSolutionAnchor } from "../lib/board";

interface Props {
  solution: BoardSolution;
  /** When set (a Completed project with a gallery entry), the button opens the
   *  Solution Gallery modal for this key instead of following a link. */
  galleryKey?: string | null;
}

const { solution, galleryKey = null } = Astro.props;
const action = boardCardAction(solution);

// Shared button styling for both the modal trigger and the plain link.
const btnClass =
  "mt-auto inline-flex items-center justify-center gap-1 rounded-lg border border-primary-500 px-3 py-2 text-xs font-semibold text-slate-700 transition hover:border-primary-400 hover:bg-primary-50 hover:text-primary-900 group-hover:border-primary-400 group-hover:bg-primary-50 group-hover:text-primary-900";

// Style each card by its Progress. Full literal class strings so Tailwind's
// scanner keeps them. Empty/unknown progress reads as "Not started".
const STATUS = {
  Completed: {
    label: "Completed",
    accent: "bg-primary-400",
    badge: "border-primary-300 bg-primary-100 text-primary-900",
  },
  "In-Progress": {
    label: "In progress",
    accent: "bg-amber-300",
    badge: "border-amber-300 bg-amber-100 text-amber-900",
  },
  "Not Started": {
    label: "Not started",
    accent: "bg-slate-300",
    badge: "border-slate-300 bg-slate-100 text-slate-600",
  },
} as const;
const status =
  STATUS[solution.progress as keyof typeof STATUS] ?? STATUS["Not Started"];
---

<div
  id={potentialSolutionAnchor(solution.pageId)}
  class="group flex h-full scroll-mt-24 flex-col overflow-hidden rounded-xl border border-b-4 border-slate-400 bg-white transition target:ring-2 target:ring-amber-400 hover:-translate-y-1 hover:shadow-lg"
>
  <div class={`h-1.5 w-full ${status.accent}`}></div>
  <div class="flex h-full flex-col gap-2 p-4">
    <h3 class="text-base font-bold leading-snug text-slate-900">
      {solution.name}
    </h3>
    {
      solution.oneLiner && (
        <p class="line-clamp-3 text-sm leading-snug text-slate-600">
          {solution.oneLiner}
        </p>
      )
    }
    {
      solution.contributors && (
        <p class="line-clamp-1 text-xs text-slate-500">
          <span class="font-semibold text-slate-600">By</span>{" "}
          {solution.contributors}
        </p>
      )
    }
    {
      galleryKey ? (
        <button type="button" data-solution-open={galleryKey} class={btnClass}>
          See solution
          <span aria-hidden="true">&rarr;</span>
        </button>
      ) : (
        action && (
          <a
            href={action.href}
            target="_blank"
            rel="noopener noreferrer"
            class={btnClass}
          >
            {action.label}
            <span aria-hidden="true">&rarr;</span>
          </a>
        )
      )
    }
  </div>
</div>
