---
import type { BoardSolution } from "../lib/board";
import { potentialSolutionAnchor } from "../lib/board";

interface Props {
  solution: BoardSolution;
  /** When set (a Completed project with a gallery entry), the button opens the
   *  Solution Gallery modal for this key instead of following a link. */
  galleryKey?: string | null;
  /** Denser card for secondary sections that pack more per row (the
   *  Collaborative Build Cohort); the Project Board grid uses the full size. */
  compact?: boolean;
}

const { solution, galleryKey = null, compact = false } = Astro.props;

// Both size sets spelled out as full literal class strings so Tailwind's
// scanner keeps them. `clamp` is mirrored onto data-clamp for the toggle script.
const SIZE = compact
  ? {
      accent: "h-1",
      body: "gap-1.5 p-3",
      title: "text-sm",
      clamp: "line-clamp-2",
      oneLiner: "text-xs",
      small: "text-[11px]",
      btnSize: "px-2.5 py-1.5 text-[11px]",
    }
  : {
      accent: "h-1.5",
      body: "gap-2 p-4",
      title: "text-base",
      clamp: "line-clamp-3",
      oneLiner: "text-sm",
      small: "text-xs",
      btnSize: "px-3 py-2 text-xs",
    };

// Shared button styling for both the modal trigger and the plain link.
const btnClass = `mt-auto inline-flex cursor-pointer items-center justify-center gap-1 rounded-lg border border-primary-500 ${SIZE.btnSize} font-semibold text-slate-700 transition hover:border-primary-400 hover:bg-primary-50 hover:text-primary-900 group-hover:border-primary-400 group-hover:bg-primary-50 group-hover:text-primary-900`;

// Style each card by its Progress. Full literal class strings so Tailwind's
// scanner keeps them. Empty/unknown progress reads as "Not started".
const STATUS = {
  Completed: {
    label: "Completed",
    accent: "bg-primary-400",
    badge: "border-primary-300 bg-primary-100 text-primary-900",
  },
  "In-Progress": {
    label: "In progress",
    accent: "bg-amber-300",
    badge: "border-amber-300 bg-amber-100 text-amber-900",
  },
  "Not Started": {
    label: "Not started",
    accent: "bg-slate-300",
    badge: "border-slate-300 bg-slate-100 text-slate-600",
  },
} as const;
const status =
  STATUS[solution.progress as keyof typeof STATUS] ?? STATUS["Not Started"];
---

<div
  id={potentialSolutionAnchor(solution.pageId)}
  class="group flex h-full scroll-mt-24 flex-col overflow-hidden rounded-xl border border-b-4 border-slate-400 bg-white transition target:ring-2 target:ring-amber-400 hover:-translate-y-1 hover:shadow-lg"
>
  <div class={`${SIZE.accent} w-full ${status.accent}`}></div>
  <div class={`flex h-full flex-col ${SIZE.body}`}>
    <div class="flex items-start justify-between gap-2">
      <h3 class={`${SIZE.title} font-bold leading-snug text-slate-900`}>
        {solution.name}
      </h3>
      {
        solution.forumLink && (
          <a
            href={solution.forumLink}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Open forum for ${solution.name}`}
            class="shrink-0 rounded-md p-1 text-slate-400 transition hover:bg-primary-50 hover:text-primary-700"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-5 w-5"
              aria-hidden="true"
            >
              <path
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
              />
            </svg>
          </a>
        )
      }
    </div>
    {
      solution.oneLiner && (
        <div>
          <p
            data-oneliner
            data-clamp={SIZE.clamp}
            class={`${SIZE.clamp} ${SIZE.oneLiner} leading-snug text-slate-600`}
          >
            {solution.oneLiner}
          </p>
          <button
            type="button"
            data-oneliner-toggle
            aria-expanded="false"
            class={`hidden ${SIZE.small} font-medium text-slate-400 transition hover:text-slate-700`}
          >
            Show more
          </button>
        </div>
      )
    }
    {
      solution.contributors && (
        <p class={`line-clamp-1 ${SIZE.small} text-slate-500`}>
          <span class="font-semibold text-slate-600">By</span>{" "}
          {solution.contributors}
        </p>
      )
    }
    {
      galleryKey ? (
        <button type="button" data-solution-open={galleryKey} class={btnClass}>
          Open
          <span aria-hidden="true">&rarr;</span>
        </button>
      ) : (
        <button
          type="button"
          data-progress-open={solution.pageId}
          class={btnClass}
        >
          Open
          <span aria-hidden="true">&rarr;</span>
        </button>
      )
    }
  </div>
</div>

<script>
  // The clamp class differs by card size (compact cards clamp tighter), so each
  // one carries its own in data-clamp rather than sharing a constant.
  const clampOf = (text: HTMLElement) =>
    text.dataset.clamp || "line-clamp-3";

  // The toggle is only useful when the one-liner actually overflows its clamp,
  // which depends on the rendered column width — so measure rather than guess.
  function syncToggle(text: HTMLElement, toggle: HTMLElement) {
    if (!text.classList.contains(clampOf(text))) return; // expanded: keep "Show less"
    toggle.classList.toggle("hidden", text.scrollHeight <= text.clientHeight + 1);
  }

  document.querySelectorAll<HTMLElement>("[data-oneliner]").forEach((text) => {
    const toggle = text.nextElementSibling;
    if (!(toggle instanceof HTMLElement)) return;

    syncToggle(text, toggle);
    window.addEventListener("resize", () => syncToggle(text, toggle));

    toggle.addEventListener("click", () => {
      const expanded = !text.classList.toggle(clampOf(text));
      toggle.textContent = expanded ? "Show less" : "Show more";
      toggle.setAttribute("aria-expanded", String(expanded));
    });
  });
</script>
