---
import Layout from "../../components/Layout.astro";
import BoardNav from "../../components/BoardNav.astro";
import ProblemLinkList from "../../components/ProblemLinkList.astro";
import { getCollection } from "astro:content";
import { getProblemLookup, normalizeUrl, type ProblemLink } from "../../lib/board";

const [rows, lookup] = await Promise.all([
  getCollection("solutions"),
  getProblemLookup(),
]);

const MONTHS = [
  "Jan", "Feb", "Mar", "Apr", "May", "Jun",
  "Jul", "Aug", "Sep", "Oct", "Nov", "Dec",
];
// Format an ISO date-only string without timezone drift.
const formatDate = (iso: string) => {
  const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(iso);
  if (!m) return "";
  return `${MONTHS[Number(m[2]) - 1]} ${Number(m[3])}, ${m[1]}`;
};

const gallery = rows
  .map((row) => ({
    name: row.data.name,
    href: normalizeUrl(row.data.url),
    builtBy: row.data.builtBy,
    date: formatDate(row.data.date),
    sortKey: row.data.date,
    problems: row.data.problemIds
      .map(lookup)
      .filter((p): p is ProblemLink => p !== null),
  }))
  // Most recently completed first.
  .sort((a, b) => b.sortKey.localeCompare(a.sortKey));
---

<Layout title="Completed Solutions">
  <section>
    <BoardNav current="completed" />
    <h1 class="mt-6 text-3xl font-bold text-slate-900">Completed Solutions</h1>
    <p class="mt-2 text-slate-600">
      {gallery.length} solutions built for teachers.
    </p>

    {
      gallery.length === 0 ? (
        <p class="mt-8 py-8 text-center italic text-slate-500">
          No completed solutions yet — check back during the event.
        </p>
      ) : (
        <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {gallery.map((item) => (
            <div class="flex flex-col gap-3 rounded-lg border border-b-4 border-slate-400 bg-white p-5">
              <div class="flex flex-col gap-1">
                <h2 class="text-lg font-semibold leading-snug text-slate-900">
                  {item.href ? (
                    <a
                      href={item.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="hover:underline"
                    >
                      {item.name}
                    </a>
                  ) : (
                    item.name
                  )}
                </h2>
                <div class="flex flex-wrap gap-x-3 text-sm text-slate-500">
                  {item.builtBy && <span>Built by {item.builtBy}</span>}
                  {item.date && <span>{item.date}</span>}
                </div>
              </div>
              <ProblemLinkList problems={item.problems} label="Solves:" />
              {item.href && (
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-auto text-sm font-semibold text-slate-700 hover:underline"
                >
                  Visit solution &rarr;
                </a>
              )}
            </div>
          ))}
        </div>
      )
    }
  </section>
</Layout>
