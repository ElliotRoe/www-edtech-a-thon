              <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                <h3 class="text-2xl font-extrabold text-slate-950">
                  {organizer.name}
                </h3>
                {organizer.siteHref && (
                  <a
                    href={organizer.siteHref}
                    target="_blank"
                    rel="noreferrer"
                    class="text-xs font-bold uppercase text-slate-500 transition hover:text-slate-950"
                  >
                    {organizer.siteLabel}
                  </a>
                )}
              </div>
              <p class="mt-3 text-base leading-7 text-slate-700">
                {organizer.blurb}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <script slot="scripts">
    const newsletterDialog = document.querySelector(
      "[data-newsletter-dialog]",
    );
    const newsletterForms = document.querySelectorAll(
      "[data-newsletter-form]",
    );
    const pageParams = new URLSearchParams(window.location.search);
    const shouldOpenNewsletter = pageParams.has("subscribe");

    function getNewsletterStatus(form) {
      return form
        .closest("[data-newsletter-signup]")
        ?.querySelector("[data-newsletter-status]");
    }

    function removeUrlParam(name) {
      const cleanUrl = new URL(window.location.href);
      if (!cleanUrl.searchParams.has(name)) return;

      cleanUrl.searchParams.delete(name);
      window.history.replaceState(
        window.history.state,
        "",
        `${cleanUrl.pathname}${cleanUrl.search}${cleanUrl.hash}`,
      );
    }

    newsletterForms.forEach((form) => {
      if (!(form instanceof HTMLFormElement)) return;

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        const emailInput = form.elements.namedItem("email");
        const websiteInput = form.elements.namedItem("website");
        const submitButton = form.querySelector("button[type='submit']");
        const newsletterStatus = getNewsletterStatus(form);

        if (!(emailInput instanceof HTMLInputElement)) return;

        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = true;
          submitButton.textContent = "Signing Up…";
        }
        if (newsletterStatus instanceof HTMLElement) {
          newsletterStatus.textContent = "Submitting your email…";
          newsletterStatus.classList.remove(
            "text-red-700",
            "text-primary-700",
          );
        }

        try {
          const body = new URLSearchParams({
            email: emailInput.value,
            website:
              websiteInput instanceof HTMLInputElement
                ? websiteInput.value
                : "",
          });
          const response = await fetch(form.action, {
            method: "POST",
            headers: {
              "Content-Type": "application/x-www-form-urlencoded",
              Accept: "application/json",
            },
            body,
          });
          const result = await response.json();

          if (!response.ok) {
            throw new Error(result.message || "Unable to subscribe");
          }

          form.reset();
          if (newsletterStatus instanceof HTMLElement) {
            newsletterStatus.textContent = result.message;
            newsletterStatus.classList.add("text-primary-700");
          }
        } catch (error) {
          if (newsletterStatus instanceof HTMLElement) {
            newsletterStatus.textContent =
              error instanceof Error
                ? error.message
                : "Unable to subscribe. Please try again.";
            newsletterStatus.classList.add("text-red-700");
          }
        } finally {
          if (submitButton instanceof HTMLButtonElement) {
            submitButton.disabled = false;
            submitButton.textContent = "Sign Up for Our Newsletter";
          }
        }
      });
    });

    if (
      shouldOpenNewsletter &&
      newsletterDialog instanceof HTMLDialogElement
    ) {
      newsletterDialog.showModal();
    }

    if (newsletterDialog instanceof HTMLDialogElement) {
      newsletterDialog
        .querySelector("[data-newsletter-close]")
        ?.addEventListener("click", () => newsletterDialog.close());
      newsletterDialog.addEventListener("click", (event) => {
        if (event.target === newsletterDialog) newsletterDialog.close();
      });
      newsletterDialog.addEventListener("close", () => {
        removeUrlParam("subscribe");
      });
    }

    const consentEmail = pageParams.get("consent");
    const targetForm = shouldOpenNewsletter
      ? newsletterDialog?.querySelector("[data-newsletter-form]")
      : newsletterForms.item(0);

    if (consentEmail && targetForm instanceof HTMLFormElement) {
      const emailInput = targetForm.elements.namedItem("email");
      const newsletterStatus = getNewsletterStatus(targetForm);

      if (emailInput instanceof HTMLInputElement) {
        emailInput.value = consentEmail;

        if (emailInput.checkValidity()) {
          removeUrlParam("consent");
          targetForm.requestSubmit();
        } else if (newsletterStatus instanceof HTMLElement) {
          newsletterStatus.textContent =
            "The newsletter signup link contains an invalid email address.";
          newsletterStatus.classList.add("text-red-700");
        }
      }
    }
  </script>

