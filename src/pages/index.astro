    slot="announcement"
    aria-label="Event status"
    class="rounded-full border border-primary-400 bg-primary-100 px-2 py-1 text-center font-semibold text-primary-950 w-fit text-sm mx-auto mt-5"
  >
    EdTech-a-thon 2026 is over!
  </aside>

  <section class="grid gap-8 lg:grid-cols-[1fr_360px] lg:items-center">
    <div class="flex flex-col gap-5">
      <h1 class="text-xl text-slate-600 uppercase">
        Real teachers. Real problems. Real solutions.
      </h1>
      <p class="text-4xl font-semibold text-slate-900">
        Pairing educators with developers for a 3-day problem-solving marathon
      </p>
      <p class="text-lg leading-8 text-slate-700">
        Educators and developers live in different worlds. We're bringing them
        together from July 20-22, virtually and in-person in Atlanta, GA, for
        three days of collaboration, community, and problem solving.
      </p>
      <NewsletterSignup id="hero-newsletter" />
    </div>
    <div
      class="polaroid-stack"
      aria-label="Educators and developers collaborating"
    >
      <figure class="polaroid polaroid-back" aria-hidden="true">
        <img src="/hero-3.jpg" alt="" />
      </figure>
      <figure class="polaroid polaroid-middle" aria-hidden="true">
        <img src="/hero-2.jpg" alt="" />
      </figure>
      <figure class="polaroid polaroid-front">
        <Image
          src={edtechathon2026Group}
          alt="EdTech-a-thon 2026 participants gathered in Atlanta with virtual attendees joining onscreen"
          width={576}
          widths={[320, 576]}
          sizes="(min-width: 1024px) 336px, 288px"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <dialog
    class="m-auto w-[calc(100%_-_2rem)] max-w-lg rounded-2xl border border-slate-400 border-b-4 bg-white p-0 text-slate-950 shadow-2xl backdrop:bg-slate-950/60"
    aria-labelledby="newsletter-dialog-heading"
    data-newsletter-dialog
  >
    <div class="p-6 sm:p-8">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p
            class="text-sm font-extrabold uppercase tracking-wide text-primary-700"
          >
            Stay in the loop
          </p>
          <h2
            id="newsletter-dialog-heading"
            class="mt-2 text-3xl font-extrabold text-slate-950"
          >
            Join our newsletter
          </h2>
        </div>
        <button
          type="button"
          class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-slate-300 text-2xl leading-none text-slate-600 transition hover:bg-slate-100 hover:text-slate-950"
          aria-label="Close newsletter signup"
          data-newsletter-close
        >
          &times;
        </button>
      </div>
      <p class="mt-3 mb-6 leading-7 text-slate-700">
        Hear about future EdTech-a-thons and the free tools we build with
        educators.
      </p>
      <NewsletterSignup id="modal-newsletter" autofocus />
    </div>
  </dialog>

