---
import Layout from "../../components/Layout.astro";
import BoardNav from "../../components/BoardNav.astro";
import SolutionBoard from "../../components/SolutionBoard.astro";
import { getBoardSolutions } from "../../lib/board";

const solutions = await getBoardSolutions("Yes");
---

<Layout title="Problem Board">
  <section>
    <BoardNav current="board" />
    <h1 class="mt-6 text-3xl font-bold text-slate-900">Problem Board</h1>
    <p class="mt-2 text-slate-600">
      {solutions.length} solutions accepted to be built at the event.
    </p>
    <div class="mt-6">
      <SolutionBoard
        solutions={solutions}
        emptyText="No accepted solutions yet."
      />
    </div>
  </section>
</Layout>
