---
import { getCollection } from "astro:content";
import Layout from "../../../components/Layout.astro";
import Submission from "../../../components/Submission.astro";
import SubmissionPart from "../../../components/SubmissionPart.astro";
import { getSolversByProblem } from "../../../lib/board";

export async function getStaticPaths() {
  const [problems, solversByProblem] = await Promise.all([
    getCollection("problems"),
    getSolversByProblem(),
  ]);
  return problems.map((problem) => ({
    params: { slug: problem.id }, // entry id is the lowercased PR id, e.g. "pr-123"
    props: {
      problem,
      solvers: solversByProblem.get(problem.data.pageId) ?? {
        potential: [],
        completed: [],
      },
    },
  }));
}

const { problem, solvers } = Astro.props;
const { prId, title, problem: problemText, solution } = problem.data;
const hasSolvers = solvers.potential.length > 0 || solvers.completed.length > 0;

// Split redacted text into paragraphs on blank lines; single newlines are kept
// via `whitespace-pre-line` on the container.
const toParagraphs = (text: string) =>
  text
    .split(/\n{2,}/)
    .map((p) => p.trim())
    .filter(Boolean);
---

<Layout title={[title, "Problem"]}>
  <section>
    <a href="/problem-database" class="hover:underline">&larr; Problem Database</a>
    <div class="mt-4 text-sm text-slate-500">{prId}</div>
    <h1 class="text-4xl font-bold text-slate-900 mt-1">{title}</h1>

    <div class="mt-8">
      <Submission>
        <SubmissionPart type="problem">
          {
            problemText
              ? toParagraphs(problemText).map((p) => (
                  <p class="whitespace-pre-line">{p}</p>
                ))
              : <p class="italic text-slate-500">No description provided.</p>
          }
        </SubmissionPart>
        {
          solution && (
            <SubmissionPart type="proposed-solution">
              {toParagraphs(solution).map((p) => (
                <p class="whitespace-pre-line">{p}</p>
              ))}
            </SubmissionPart>
          )
        }
      </Submission>
    </div>

    {
      hasSolvers && (
        <div class="mt-8 rounded-lg border border-slate-200 bg-slate-50 p-5">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">
            Solutions for this problem
          </h2>
          <ul class="mt-3 flex flex-col gap-2">
            {solvers.completed.map((s) => (
              <li class="flex flex-wrap items-center gap-2">
                <span class="rounded-md bg-green-100 px-2 py-0.5 text-xs font-semibold text-green-800">
                  Completed
                </span>
                {s.url ? (
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-slate-800 hover:underline"
                  >
                    {s.name}
                  </a>
                ) : (
                  <span class="text-slate-800">{s.name}</span>
                )}
              </li>
            ))}
            {solvers.potential.map((s) => (
              <li class="flex flex-wrap items-center gap-2">
                <span
                  class={`rounded-md px-2 py-0.5 text-xs font-semibold ${
                    s.accepted === "Extra Credit"
                      ? "bg-purple-100 text-purple-800"
                      : "bg-amber-100 text-amber-800"
                  }`}
                >
                  {s.accepted === "Extra Credit" ? "Extra Credit" : "Planned"}
                </span>
                <a href={s.href} class="text-slate-800 hover:underline">
                  {s.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>
</Layout>
