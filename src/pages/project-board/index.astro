---
import Layout from "../../components/Layout.astro";
import ProgressBar from "../../components/ProgressBar.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import ProjectProgressModal from "../../components/ProjectProgressModal.svelte";
import SolutionModal from "../../components/SolutionModal.svelte";
import {
  getBoardSolutions,
  getBoardProgress,
  getGalleryForBoard,
  potentialSolutionAnchor,
} from "../../lib/board";

const [projects, vibeCode, extraCredit, progress, gallery] = await Promise.all([
  getBoardSolutions("Yes"),
  getBoardSolutions("Vibe Code"),
  getBoardSolutions("Extra Credit"),
  getBoardProgress(),
  getGalleryForBoard(),
]);
// Resolve a completed project to the key that opens its gallery modal.
const { items: galleryItems, keyFor } = gallery;
const progressItems = [...projects, ...vibeCode, ...extraCredit]
  .map((solution) => ({
    key: solution.pageId,
    name: solution.name,
    authorLine: solution.authorLine,
    description: solution.oneLiner,
    videoLink: solution.youtubeLink,
  }));

// Compact-list status label + dot colour for the Extra Credit rows.
const EC_STATUS: Record<string, { label: string; dot: string }> = {
  Completed: { label: "Completed", dot: "bg-primary-400" },
  "In-Progress": { label: "In progress", dot: "bg-amber-300" },
  "Not Started": { label: "Not started", dot: "bg-slate-300" },
};
const ecStatus = (p: string) =>
  EC_STATUS[p] ?? { label: "Not started", dot: "bg-slate-300" };
---

<Layout title="Project Board">
  <section class="flex flex-col gap-8">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900 sm:text-4xl">
        Project Board
      </h1>
      <p class="mt-2 text-slate-600">
        The solutions our teams are building at EdTech-a-thon. Open a project
        to learn more and watch its progress video.
      </p>
    </div>

    <ProgressBar progress={progress} />

    {
      projects.length === 0 ? (
        <p class="py-8 text-center italic text-slate-500">
          No accepted projects yet — check back soon.
        </p>
      ) : (
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {projects.map((solution) => (
            <ProjectCard solution={solution} galleryKey={keyFor(solution)} />
          ))}
        </div>
      )
    }

    {
      vibeCode.length > 0 && (
        <div class="border-t border-dashed border-slate-300 pt-6">
          <div class="flex flex-wrap items-baseline gap-x-2">
            <h2 class="text-xl font-bold text-slate-900">
              Collaborative Build Cohort
            </h2>
            <span class="text-sm text-slate-500">
              educators building apps directly, with developers supporting
            </span>
          </div>
          <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
            {vibeCode.map((solution) => (
              <ProjectCard
                solution={solution}
                galleryKey={keyFor(solution)}
                compact
              />
            ))}
          </div>
        </div>
      )
    }

    {
      extraCredit.length > 0 && (
        <div class="border-t border-dashed border-slate-300 pt-6">
          <div class="flex items-baseline gap-2">
            <h2 class="text-xl font-bold text-slate-900">Extra Credit</h2>
            <span class="text-sm text-slate-500">
              stretch goals if there's time
            </span>
          </div>
          <ul class="mt-3 flex flex-col divide-y divide-slate-200 overflow-hidden rounded-lg border border-slate-300 bg-white">
            {extraCredit.map((s) => {
              const st = ecStatus(s.progress);
              // Completed projects with gallery entries open their showcase
              // modal; every other project opens the progress modal.
              const galleryKey = keyFor(s);
              const rowClass = "flex w-full items-center gap-3 px-4 py-2.5 text-left text-sm transition hover:bg-slate-50";
              const rowContent = (
                <>
                  <span
                    class={`h-2.5 w-2.5 shrink-0 rounded-full ${st.dot}`}
                    title={st.label}
                  />
                  <span class="shrink-0 font-semibold text-slate-800">
                    {s.name}
                  </span>
                  {s.oneLiner && (
                    <span class="hidden text-slate-500 sm:inline">
                      &mdash; {s.oneLiner}
                    </span>
                  )}
                  <span class="ml-auto shrink-0 text-xs font-medium text-slate-400">
                    {st.label}
                  </span>
                </>
              );
              return (
                <li
                  id={potentialSolutionAnchor(s.pageId)}
                  class="scroll-mt-24 target:bg-amber-50"
                >
                  {galleryKey ? (
                    <button
                      type="button"
                      data-solution-open={galleryKey}
                      class={rowClass}
                    >
                      {rowContent}
                    </button>
                  ) : (
                    <button
                      type="button"
                      data-progress-open={s.pageId}
                      class={rowClass}
                    >
                      {rowContent}
                    </button>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      )
    }

    <div class="border-t border-slate-200 pt-6">
      <a
        href="/problem-database"
        class="text-sm font-medium text-slate-500 transition hover:text-slate-900"
      >
        Browse all submitted classroom problems &rarr;
      </a>
    </div>

    {progressItems.length > 0 && (
      <ProjectProgressModal client:load items={progressItems} />
    )}
    {galleryItems.length > 0 && (
      <SolutionModal client:load items={galleryItems} />
    )}
  </section>
</Layout>

<script>
  // Modal triggers live in Astro-rendered cards/rows, so forward clicks to the
  // appropriate Svelte island once it is ready.
  document.addEventListener("click", (event) => {
    const el = (event.target as HTMLElement).closest<HTMLElement>(
      "[data-solution-open], [data-progress-open]",
    );
    if (!el) return;
    const isSolution = el.hasAttribute("data-solution-open");
    if (
      isSolution &&
      document.documentElement.dataset.solutionModalReady !== "true"
    ) {
      return;
    }
    const key = el.getAttribute(
      isSolution ? "data-solution-open" : "data-progress-open",
    );
    if (key) {
      window.dispatchEvent(
        new CustomEvent(
          isSolution ? "open-solution" : "open-project-progress",
          { detail: key },
        ),
      );
    }
  });
</script>
